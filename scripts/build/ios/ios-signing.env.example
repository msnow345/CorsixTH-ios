# CorsixTH-iOS @build 2026-09-06 Copy to ios-signing.env (git-ignored) and fill in.
# scripts/build/ios/package-ios.sh sources it automatically; anything already exported in
# your shell wins over what is set here.

# Apple Developer team id, as passed to xcodebuild's DEVELOPMENT_TEAM.
export CORSIXTH_IOS_TEAM_ID=XXXXXXXXXX

# The FULL codesign identity string. `security find-identity -v -p codesigning` prints it.
# Never abbreviate it to "Apple Development": once a machine has certificates from more
# than one team the prefix is ambiguous and codesign fails outright. The id in parentheses
# here is the certificate's own identifier and normally differs from the team id above.
export CORSIXTH_IOS_CODESIGN_IDENTITY="Apple Development: Your Name (YYYYYYYYYY)"

# CFBundleIdentifier. Must be unique per team; changing it installs a second app.
export CORSIXTH_IOS_BUNDLE_ID=com.example.corsixth

# Optional. `xcrun devicectl list devices` prints the Identifier used for install/launch.
export CORSIXTH_IOS_DEVICE=00000000-0000-0000-0000-000000000000

# Optional but needed the first time a team registers this device: the *hardware* UDID
# that xcodebuild -destination wants. It is NOT the devicectl identifier above; read it
# from Xcode > Window > Devices and Simulators, or `xcrun devicectl list devices -v`.
export CORSIXTH_IOS_DEVICE_UDID=00000000-000000000000000

# Optional bundle metadata. Bump CFBundleVersion when an icon change must beat
# SpringBoard's icon cache.
# export CORSIXTH_IOS_SHORT_VERSION=0.70
# export CORSIXTH_IOS_BUNDLE_VERSION=1

# Optional app-icon compositing controls (see scripts/build/ios/make-icons.sh).
# export CORSIXTH_IOS_ICON_SOURCE=CorsixTH/Icon.icns
# export CORSIXTH_IOS_ICON_BG=111111
# export CORSIXTH_IOS_ICON_INSET=0.05
